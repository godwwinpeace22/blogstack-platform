{
  "name": "@blogstack/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "migrate:local": "wrangler d1 migrations apply MAIN_DB --local",
    "migrate:remote": "wrangler d1 migrations apply MAIN_DB --remote",
    "test": "bun test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@hono/zod-validator": "^0.4.0",
    "better-auth": "1.7.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "shiki": "^1.22.0",
    "zod": "^4.0.0",
    "@blogstack/core": "^0.2.0",
    "@polar-sh/sdk": "1.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261118.1",
    "typescript": "^5.7.0",
    "wrangler": "4.129.1"
  }
}
