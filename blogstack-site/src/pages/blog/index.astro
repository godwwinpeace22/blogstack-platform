---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
}
---

<Layout
  title="Blog — BlogStack.io"
  description="Engineering updates, tutorials, and announcements from the BlogStack team."
>
  <nav class="page-nav">
    <a href="/" class="nav-logo"><div class="dot"></div>BlogStack</a>
    <ul class="nav-links">
      <li><a href="/#components">Features</a></li>
      <li><a href="/#pricing">Pricing</a></li>
      <li><a href="/privacy">Privacy</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="https://blogstack-docs.hidden-silence-2d18.workers.dev">Docs</a></li>
    </ul>
    <div class="nav-cta">
      <a href="https://blogstack-app.hidden-silence-2d18.workers.dev/login" class="btn btn-ghost">Sign in</a>
      <a href="https://blogstack-app.hidden-silence-2d18.workers.dev/register" class="btn btn-primary">Get started →</a>
    </div>
  </nav>

  <main id="main-content" class="page-main">
    <section class="hero">
      <p class="eyebrow">// Blog</p>
      <h1>Engineering notes and product updates.</h1>
      <p class="hero-sub">Tutorials, release notes, architecture deep dives, and practical implementation guides from the BlogStack team.</p>
    </section>

    <section class="post-grid-wrap">
      <div class="post-grid">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="post-card">
          <div class="post-meta">
            <time datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
            {post.data.tags.length > 0 && (
              <span class="post-tag">{post.data.tags[0]}</span>
            )}
          </div>
          <h2 class="post-title">{post.data.title}</h2>
          <p class="post-desc">{post.data.description}</p>
          <span class="post-read-more">
            Read article
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      ))}
      </div>

      {posts.length === 0 && (
        <p class="empty-state">No posts yet — check back soon.</p>
      )}
    </section>
  </main>

  <footer class="page-footer">
    <div class="footer-logo"><div class="dot"></div>BlogStack</div>
    <ul class="footer-links">
      <li><a href="/#components">Features</a></li>
      <li><a href="/#pricing">Pricing</a></li>
      <li><a href="/privacy">Privacy</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="https://blogstack-docs.hidden-silence-2d18.workers.dev">Docs</a></li>
    </ul>
    <div class="footer-copy">© 2026 BlogStack</div>
  </footer>
</Layout>

<style>
  .page-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 40px;
    height: 56px;
    border-bottom: 1px solid var(--border);
    background: rgba(9, 9, 11, 0.85);
    backdrop-filter: blur(12px);
  }

  .nav-logo,
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 14px;
    color: var(--text);
    text-decoration: none;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .nav-links,
  .footer-links {
    display: flex;
    gap: 24px;
    list-style: none;
  }

  .nav-links a,
  .footer-links a {
    color: var(--text-muted);
    font-size: 13px;
    text-decoration: none;
  }

  .nav-links a:hover,
  .footer-links a:hover,
  .post-card:hover .post-read-more {
    color: var(--text);
  }

  .nav-cta {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 13px;
    font-family: var(--sans);
    text-decoration: none;
    transition: all 0.15s;
    white-space: nowrap;
    border: 1px solid transparent;
  }

  .btn-ghost {
    color: var(--text-muted);
    border-color: var(--border);
  }

  .btn-ghost:hover {
    color: var(--text);
    border-color: var(--border-light);
  }

  .btn-primary {
    background: var(--accent);
    color: #000;
    font-weight: 600;
  }

  .btn-primary:hover {
    background: var(--accent-dim);
    transform: translateY(-1px);
  }

  .page-main {
    padding-top: 96px;
  }

  section {
    max-width: 1120px;
    margin: 0 auto;
    padding: 44px 40px;
  }

  .hero {
    text-align: center;
    padding-top: 70px;
    padding-bottom: 24px;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
  }

  h1 {
    font-family: var(--serif);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.05;
    font-size: clamp(42px, 7vw, 74px);
    margin-bottom: 14px;
  }

  .hero-sub {
    color: var(--text-muted);
    font-size: 17px;
    line-height: 1.7;
    max-width: 740px;
    margin: 0 auto;
  }

  .post-grid-wrap {
    padding-top: 22px;
    padding-bottom: 88px;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  .post-card {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 22px;
    transition: border-color 0.2s, transform 0.2s;
  }

  .post-card:hover {
    border-color: var(--border-light);
    transform: translateY(-1px);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .post-meta time {
    font-size: 11px;
    color: var(--text-muted);
    font-family: var(--mono);
  }

  .post-tag {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 999px;
    background: var(--accent-subtle);
    color: var(--accent);
    border: 1px solid rgba(232, 255, 71, 0.2);
  }

  .post-title {
    font-family: var(--serif);
    font-size: 30px;
    line-height: 1.05;
    font-weight: 400;
    letter-spacing: -0.015em;
    margin-bottom: 8px;
  }

  .post-desc {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 14px;
  }

  .post-read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 12px;
    font-family: var(--mono);
    color: var(--accent);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.15s;
  }

  .empty-state {
    color: var(--text-muted);
    text-align: center;
    grid-column: 1 / -1;
    padding: 3rem 0;
  }

  .page-footer {
    border-top: 1px solid var(--border);
    padding: 32px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .footer-copy {
    color: var(--text-dim);
    font-family: var(--mono);
    font-size: 12px;
  }

  @media (max-width: 980px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .page-nav {
      height: auto;
      padding: 12px 20px;
      flex-wrap: wrap;
      gap: 12px;
    }

    .nav-links {
      width: 100%;
      order: 3;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }

    .page-main {
      padding-top: 140px;
    }

    section,
    .page-footer {
      padding-left: 20px;
      padding-right: 20px;
    }
  }

  @media (max-width: 520px) {
    .nav-cta {
      width: 100%;
      flex-direction: column;
    }

    .nav-cta .btn {
      width: 100%;
    }

    .footer-links {
      width: 100%;
      flex-wrap: wrap;
    }
  }
</style>
