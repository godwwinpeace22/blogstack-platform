---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
}
---

<Layout title={`${post.data.title} — BlogStack Blog`} description={post.data.description}>
  <nav class="page-nav">
    <a href="/" class="nav-logo"><div class="dot"></div>BlogStack</a>
    <ul class="nav-links">
      <li><a href="/#components">Features</a></li>
      <li><a href="/#pricing">Pricing</a></li>
      <li><a href="/privacy">Privacy</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="https://blogstack-docs.hidden-silence-2d18.workers.dev">Docs</a></li>
    </ul>
    <div class="nav-cta">
      <a href="https://blogstack-app.hidden-silence-2d18.workers.dev/login" class="btn btn-ghost">Sign in</a>
      <a href="https://blogstack-app.hidden-silence-2d18.workers.dev/register" class="btn btn-primary">Get started →</a>
    </div>
  </nav>

  <main id="main-content" class="page-main">
    <article class="post-page">
      <header class="post-header">
        <p class="eyebrow">// Article</p>
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          {post.data.tags.map((tag) => (
            <span class="post-tag">{tag}</span>
          ))}
        </div>
        <h1>{post.data.title}</h1>
        <p class="post-description">{post.data.description}</p>
        <p class="post-author">Written by {post.data.author}</p>
      </header>

      <div class="post-content">
        <Content />
      </div>

      <a href="/blog" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back to blog
      </a>
    </article>
  </main>

  <footer class="page-footer">
    <div class="footer-logo"><div class="dot"></div>BlogStack</div>
    <ul class="footer-links">
      <li><a href="/#components">Features</a></li>
      <li><a href="/#pricing">Pricing</a></li>
      <li><a href="/privacy">Privacy</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="https://blogstack-docs.hidden-silence-2d18.workers.dev">Docs</a></li>
    </ul>
    <div class="footer-copy">© 2026 BlogStack</div>
  </footer>
</Layout>

<style>
  .page-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 40px;
    height: 56px;
    border-bottom: 1px solid var(--border);
    background: rgba(9, 9, 11, 0.85);
    backdrop-filter: blur(12px);
  }

  .nav-logo,
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 14px;
    color: var(--text);
    text-decoration: none;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .nav-links,
  .footer-links {
    display: flex;
    gap: 24px;
    list-style: none;
  }

  .nav-links a,
  .footer-links a {
    color: var(--text-muted);
    font-size: 13px;
    text-decoration: none;
  }

  .nav-links a:hover,
  .footer-links a:hover,
  .post-content :global(a:hover) {
    color: var(--text);
  }

  .nav-cta {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 13px;
    font-family: var(--sans);
    text-decoration: none;
    transition: all 0.15s;
    white-space: nowrap;
    border: 1px solid transparent;
  }

  .btn-ghost {
    color: var(--text-muted);
    border-color: var(--border);
  }

  .btn-ghost:hover {
    color: var(--text);
    border-color: var(--border-light);
  }

  .btn-primary {
    background: var(--accent);
    color: #000;
    font-weight: 600;
  }

  .btn-primary:hover {
    background: var(--accent-dim);
    transform: translateY(-1px);
  }

  .page-main {
    padding-top: 96px;
  }

  .post-page {
    max-width: 820px;
    margin: 0 auto;
    padding: 70px 40px 84px;
  }

  .post-header {
    margin-bottom: 2.6rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 24px;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .post-meta time {
    font-size: 11px;
    color: var(--text-muted);
    font-family: var(--mono);
  }

  .post-tag {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 999px;
    background: var(--accent-subtle);
    color: var(--accent);
    border: 1px solid rgba(232, 255, 71, 0.2);
  }

  .post-header h1 {
    font-family: var(--serif);
    font-size: clamp(44px, 7vw, 76px);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.03;
    margin-bottom: 0.9rem;
  }

  .post-description {
    font-size: 17px;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 0.8rem;
  }

  .post-author {
    font-size: 12px;
    color: var(--text-dim);
    font-family: var(--mono);
  }

  /* Prose styles */
  .post-content :global(h2) {
    font-family: var(--serif);
    font-size: 38px;
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-top: 2.8rem;
    margin-bottom: 0.7rem;
  }

  .post-content :global(h3) {
    font-size: 22px;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.625rem;
  }

  .post-content :global(p) {
    color: var(--text-muted);
    line-height: 1.8;
    font-size: 15px;
    margin-bottom: 1.25rem;
  }

  .post-content :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .post-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    color: var(--text-muted);
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
    font-size: 15px;
  }

  .post-content :global(li) {
    margin-bottom: 0.375rem;
    line-height: 1.7;
  }

  .post-content :global(pre) {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .post-content :global(code) {
    font-family: var(--mono);
    font-size: 0.875em;
  }

  .post-content :global(p code),
  .post-content :global(li code) {
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--accent);
    padding: 0.125rem 0.4rem;
    border-radius: 4px;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: var(--text-muted);
    font-style: italic;
  }

  .post-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 3rem;
    font-size: 12px;
    font-family: var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    transition: all 0.15s;
  }

  .back-link:hover {
    color: var(--text);
  }

  .page-footer {
    border-top: 1px solid var(--border);
    padding: 32px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .footer-copy {
    color: var(--text-dim);
    font-family: var(--mono);
    font-size: 12px;
  }

  @media (max-width: 760px) {
    .page-nav {
      height: auto;
      padding: 12px 20px;
      flex-wrap: wrap;
      gap: 12px;
    }

    .nav-links {
      width: 100%;
      order: 3;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }

    .page-main {
      padding-top: 140px;
    }

    .post-page,
    .page-footer {
      padding-left: 20px;
      padding-right: 20px;
    }
  }

  @media (max-width: 520px) {
    .nav-cta {
      width: 100%;
      flex-direction: column;
    }

    .nav-cta .btn {
      width: 100%;
    }

    .footer-links {
      width: 100%;
      flex-wrap: wrap;
    }
  }
</style>
