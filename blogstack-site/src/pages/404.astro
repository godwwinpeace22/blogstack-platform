---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---
<Layout title="Page not found — BlogStack" description="Find the BlogStack installation guide, pricing and support."><Navbar/><main id="main-content" class="not-found"><p>404</p><h1>This page is missing.</h1><p>Start with the home page, or contact support if you followed a broken link.</p><nav aria-label="Helpful pages"><a href="/">Go to BlogStack</a><a href="/support">Get support</a></nav></main><Footer/></Layout>
<style>.not-found{max-width:850px;padding:100px 24px 80px;margin:auto}.not-found>p{color:var(--text-muted);line-height:1.8}.not-found h1{font:clamp(42px,7vw,72px) var(--serif);margin:20px 0}.not-found nav{display:flex;gap:26px;margin-top:30px}.not-found a{color:var(--accent)}</style>
