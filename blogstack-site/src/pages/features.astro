---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
const features=[
 ["Native website integration","Use editable React components and the Next.js reference routes, or fetch published content with a framework-independent JavaScript client. Your website keeps its own domain and design."],
 ["Hosted client publishing","Write with images, code, headings and lists. Autosave private drafts, preview changes, and publish explicitly. Invite clients with project-scoped access."],
 ["Technical and on-page SEO","Server-rendered articles, metadata, canonical URLs, social previews, BlogPosting structured data, sitemap, RSS and indexing controls. Editor checks explain common issues without spending AI credits."],
 ["Link health and click analytics","Find unhealthy links and articles needing internal references. Understand page views, referrers and the article destinations readers click."],
 ["Reviewable AI assistants","Writing, SEO and internal-link assistants read authorized blog content and prepare suggestions. Review individual changes before applying them to a draft; publishing stays in your control."],
 ["Agency branding","Studio and Growth support unlimited blogs, agency workspace name/logo and an attribution-removal setting. Growth includes 100 GB shared media storage."],
 ["Content ownership and export","Export published content, saved drafts, tags and a media manifest, with authenticated media downloads during the retention period."],
 ["Bring your existing tools","Comments and newsletter integration slots let you keep your current providers. Provider charges are separate."],
];
---
<Layout title="BlogStack features — publishing, SEO, analytics and AI" description="Add a blog to an existing website with a hosted editor, native components, SEO checks, link analytics and reviewable AI assistants."><Navbar/><main id="main-content"><header><p>BlogStack Cloud</p><h1>A blog your clients<br/>can <em>actually manage.</em></h1></header><div class="features">{features.map(([title,text])=><section><h2>{title}</h2><p>{text}</p></section>)}</div><aside><h2>Focused first release</h2><p>Native embedded admin, live collaboration, multilingual publishing, customer webhooks, scheduled publishing, ownership transfer, MCP and native comments/newsletters are not part of this release.</p></aside><a href="/#pricing" class="btn btn-primary">Explore the plans →</a></main><Footer/><style>main{max-width:1100px;margin:auto;padding:140px 32px 80px}header{margin-bottom:60px}header>p{color:var(--muted);font-size:13px}h1{font-size:clamp(40px,6vw,72px);line-height:1.12;letter-spacing:-.04em}h1 em{font-family:var(--serif,Georgia);font-weight:400}.features{display:grid;grid-template-columns:1fr 1fr;gap:40px 60px}.features h2,aside h2{font-size:22px}.features p,aside p{color:var(--muted);font-size:15px;line-height:1.8}aside{border-top:1px solid var(--border);margin:60px 0 35px;padding-top:30px}@media(max-width:700px){main{padding:110px 20px 60px}.features{grid-template-columns:1fr}}</style></Layout>
