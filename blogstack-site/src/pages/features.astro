---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Audiences from "../components/Audiences.astro";
import ArticleGraphic from "../components/ArticleGraphic.astro";
import BuyerQuestions from "../components/BuyerQuestions.astro";
import PublishingShowcase from "../components/PublishingShowcase.astro";
import PublishingTools from "../components/PublishingTools.astro";
import PublishingOwnership from "../components/PublishingOwnership.astro";
import GrowthTools from "../components/GrowthTools.astro";
import AiAssistance from "../components/AiAssistance.astro";
import SetupAssistant from "../components/SetupAssistant.astro";
import Hosting from "../components/Hosting.astro";
import { ACCESS_URL, DEMO_URL, DOCS_URL } from "../lib/site";
---
<Layout title="BlogStack features | Write, publish, and improve your blog" description="Write and preview private drafts, publish articles on your own website, and use SEO checks, link reports, analytics, and AI suggestions.">
 <Navbar/>
 <main id="main-content">
  <header class="m-section features-hero m-fade">
    <div class="hero-copy">
      <div class="m-eyebrow">Editing and publishing</div>
      <h1>From first draft<br/>to <em>live on your site.</em></h1>
      <p class="m-copy">Preview your draft in BlogStack and publish it to a page on your own domain. See where readers came from and which links they clicked.</p>
      <div class="m-actions">
        <a href={ACCESS_URL} class="m-button">Start free trial</a>
        <a href={DEMO_URL} class="m-link">See it on a live site</a>
      </div>
    </div>
    <figure class="m-shell article-example">
      <div class="m-panel">
        <div class="article-address">fieldnotes.example/blog/july-release</div>
        <ArticleGraphic kind="release" />
        <div class="article-excerpt">
          <span>Product update</span>
          <p class="article-example-title">What changed in our July release</p>
          <p>A shorter setup flow, faster search, and three improvements shaped by reader feedback.</p>
        </div>
      </div>
      <figcaption class="m-small">Example article layout</figcaption>
    </figure>
  </header>
  <div class="m-rule"></div>
  <PublishingTools />
  <div class="m-rule"></div>
  <PublishingShowcase />
  <div class="m-rule"></div>
  <section class="m-section frontend-section" aria-labelledby="frontend-title">
    <h2 class="m-title" id="frontend-title">UI components</h2>
    <p class="m-copy">Add article pages inside your existing project. Set their type, layout, and navigation to suit your site.</p>
    <div class="frontend-layouts">
      <article>
        <div class="layout-visual visual-grid" aria-hidden="true"><i></i><i></i><i></i></div>
        <h3>Blog pages</h3>
        <p>Blog index, article pages, search, tags, and pagination. Loading, empty, and error states are included.</p>
      </article>
      <article>
        <div class="layout-visual visual-editorial" aria-hidden="true"><i></i><div><b></b><b></b><b></b></div></div>
        <h3>Editable source</h3>
        <p>Use the MIT-licensed React package or copy source from the component registry.</p>
      </article>
      <article>
        <div class="layout-visual visual-code"><code>new BlogStackClient(...)</code></div>
        <h3>SDK and API</h3>
        <p>Use the Next.js starter for ready-made routes, or fetch posts in another framework with the JavaScript SDK or JSON API.</p>
      </article>
    </div>
    <a class="m-link" href={DOCS_URL + "/docs/components"}>Explore the components</a>
  </section>
  <div class="m-rule"></div><GrowthTools/><div class="m-rule"></div><AiAssistance/><div class="m-rule"></div><Audiences/><div class="m-rule"></div><SetupAssistant/><div class="m-rule"></div><PublishingOwnership/><div class="m-rule"></div><Hosting/>
  <section class="m-section integrations" aria-labelledby="integrations-title">
    <div class="m-split">
      <h2 class="m-title" id="integrations-title">Comments and <em>newsletters</em></h2>
      <div>
        <p class="m-copy">Add your own comments component below a post and a newsletter signup form on the blog.</p>
        <p class="m-small">Provider accounts and charges are separate.</p>
        <a class="m-link" href={DOCS_URL + "/docs/integrations"}>See the integration guide</a>
      </div>
    </div>
  </section>
  <div class="m-rule"></div><BuyerQuestions/><div class="m-rule"></div>
  <section class="m-section features-cta"><div class="m-eyebrow">BlogStack Cloud</div><h2 class="m-title">Get your first post<br/><em>onto your website.</em></h2><div class="m-actions"><a class="m-button" href={ACCESS_URL}>Start your free trial</a><a class="m-link" href="/pricing">Find your plan</a></div></section>
 </main><Footer/>
</Layout>
<style>.features-hero{display:grid;grid-template-columns:1.2fr 1fr;gap:75px;align-items:center;padding-top:72px;padding-bottom:84px}.features-hero h1{font:500 clamp(2.7rem,5vw,4.6rem)/1.07 var(--sans);letter-spacing:-.055em;text-wrap:balance}.features-hero h1 em{font:400 1.12em var(--serif);color:var(--accent)}.article-example{margin:0;min-width:0}.article-address{padding:13px 19px;border-bottom:1px solid var(--border);color:var(--text-muted);font:.7rem var(--mono);overflow-wrap:anywhere}.article-excerpt{padding:20px 22px 24px;color:var(--text-muted);font-size:.87rem}.article-excerpt>span{color:var(--accent);font:.7rem var(--mono)}.article-example-title{font:400 clamp(1.85rem,3.15vw,2.7rem)/1.01 var(--serif);color:var(--text);margin:9px 0 12px}.article-example figcaption{padding:10px 10px 4px}.frontend-layouts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px;margin:45px 0 32px}.frontend-layouts h3{margin:22px 0 14px}.frontend-layouts p{color:var(--text-muted);font-size:.94rem}.layout-visual{height:150px;background:var(--surface);padding:24px;border-radius:12px;display:flex;gap:10px;align-items:center}.visual-grid i{height:95px;flex:1;border-radius:5px;background:linear-gradient(150deg,#383e2c,#1c1e18);position:relative}.visual-grid i:after{content:"";position:absolute;bottom:15px;left:10px;right:10px;height:5px;background:#666d54;border-radius:3px}.visual-editorial i{width:47%;height:100%;border-radius:5px;background:#30382a}.visual-editorial>div{flex:1}.visual-editorial b{display:block;height:6px;border-radius:2px;background:#38383d;margin:12px 0}.visual-editorial b:first-child{background:#70716a;width:80%}.visual-code code{font-size:.76rem;line-height:1.7;overflow-wrap:anywhere;color:#c2cd9c}.integrations .m-copy{margin:0 0 18px}.integrations .m-link{display:inline-block;margin-top:24px}.features-cta{padding-top:50px;padding-bottom:100px;text-align:center}.features-cta .m-title{margin:auto}.features-cta .m-actions{justify-content:center}@media(max-width:900px){.features-hero{gap:36px;grid-template-columns:1fr 1fr}.frontend-layouts{gap:20px}}@media(max-width:700px){.features-hero{grid-template-columns:1fr;padding-top:70px;padding-bottom:70px}.features-hero h1{font-size:clamp(2.7rem,10vw,4rem)}.article-example{max-width:500px;width:100%;justify-self:center}.frontend-layouts{grid-template-columns:1fr;gap:34px}.layout-visual{max-width:440px}.features-cta{padding-bottom:70px}}</style>
