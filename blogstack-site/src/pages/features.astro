---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Audiences from "../components/Audiences.astro";
import PublishingShowcase from "../components/PublishingShowcase.astro";
import GrowthTools from "../components/GrowthTools.astro";
import AiAssistance from "../components/AiAssistance.astro";
import SetupAssistant from "../components/SetupAssistant.astro";
import Hosting from "../components/Hosting.astro";
import { ACCESS_URL, DEMO_URL, DOCS_URL } from "../lib/site";
---
<Layout title="BlogStack features — a better home for your next story" description="A complete publishing stack for personal blogs, company stories and client websites. Native components, private drafts, SEO, reader analytics and AI assistance.">
 <Navbar/>
 <main id="main-content">
  <header class="m-section features-hero m-fade"><div class="hero-copy"><div class="m-eyebrow">The complete publishing stack</div><h1>Everything behind<br/>a great blog.<br/><em>Already connected.</em></h1><p class="m-copy">A writing space you’ll want to open. Blog pages that belong in your website. The tools to make every story easier to find, read and improve.</p><div class="m-actions"><a href={ACCESS_URL} class="m-button">Start free trial</a><a href={DEMO_URL} class="m-link">See a live publication</a></div></div><div class="feature-map"><div class="map-core">BlogStack<span>Your publication, connected.</span></div><div class="map-path"></div><div class="map-grid"><span>Write &amp; publish</span><span>Native pages</span><span>Search &amp; SEO</span><span>Reader analytics</span><span>Healthy links</span><span>AI assistance</span></div><div class="map-bottom"><span>Your code</span><span>Your domain</span><span>Your content</span></div></div></header>
  <div class="m-rule"></div><PublishingShowcase/><div class="m-rule"></div>
  <section class="m-section frontend-section" aria-labelledby="frontend-title"><div class="m-eyebrow">A blog that belongs</div><h2 class="m-title" id="frontend-title">Your website has a point of view.<br/><em>Your blog should share it.</em></h2><p class="m-copy">Use real pages and editable components, then shape the typography, layout and reading experience around your design. Your blog lives on your routes, alongside the rest of your website.</p><div class="frontend-layouts"><article><div class="layout-visual visual-grid" aria-hidden="true"><i></i><i></i><i></i></div><h3>A complete starting point</h3><p>Blog index, article pages, search, tags and pagination. Loading, empty and error states are included.</p></article><article><div class="layout-visual visual-editorial" aria-hidden="true"><i></i><div><b></b><b></b><b></b></div></div><h3>Editable by design</h3><p>Use the React packages or install source from the component registry. MIT licensing keeps your frontend flexible.</p></article><article><div class="layout-visual visual-code"><code>new BlogStackClient(...)</code></div><h3>Your framework, your approach</h3><p>Start with the complete Next.js routes or use the framework-independent JavaScript client for a custom integration.</p></article></div><a class="m-link" href={DOCS_URL+"/docs/components"}>Explore the components</a></section>
  <div class="m-rule"></div><GrowthTools/><div class="m-rule"></div><AiAssistance/><div class="m-rule"></div><Audiences/><div class="m-rule"></div><SetupAssistant/><div class="m-rule"></div><Hosting/>
  <section class="m-section integrations"><div class="m-split"><div><div class="m-eyebrow">Bring the tools you like</div><h2 class="m-title">Make room for<br/><em>your community.</em></h2></div><div><p class="m-copy">Add your existing comments component or newsletter signup form through named integration slots. Keep your provider, your audience and the workflow you already know.</p><p class="m-small">Provider accounts and charges are separate.</p><a class="m-link" href={DOCS_URL+"/docs/integrations"}>See the integration guide</a></div></div></section>
  <section class="m-section features-cta"><div class="m-eyebrow">From the first post to the next chapter</div><h2 class="m-title">Build the blog.<br/><em>Get back to the story.</em></h2><div class="m-actions"><a class="m-button" href={ACCESS_URL}>Start your free trial</a><a class="m-link" href="/pricing">Find your plan</a></div></section>
 </main><Footer/>
</Layout>
<style>.features-hero{display:grid;grid-template-columns:1.2fr 1fr;gap:75px;align-items:center;padding-top:72px;padding-bottom:84px}.features-hero h1{font:500 clamp(2.7rem,5vw,4.6rem)/1.07 var(--sans);letter-spacing:-.055em;text-wrap:balance}.features-hero h1 em{font:400 1.12em var(--serif);color:var(--accent)}.feature-map{padding:36px 26px;background:radial-gradient(ellipse at 50% 0,rgba(232,255,71,.055),transparent 65%);border-radius:28px}.map-core{border-radius:18px;background:var(--surface);box-shadow:inset 0 1px 0 rgba(255,255,255,.08),0 0 0 6px rgba(255,255,255,.018);padding:27px;text-align:center;font:500 1.6rem var(--mono)}.map-core span{display:block;font:400 .8rem var(--sans);color:var(--text-muted);margin-top:10px}.map-path{width:1px;height:38px;background:linear-gradient(var(--accent),var(--border));margin:auto;opacity:.5}.map-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.map-grid span{border-radius:9px;padding:18px 12px;background:var(--surface);text-align:center;font-size:.85rem;box-shadow:inset 0 1px 0 rgba(255,255,255,.045)}.map-bottom{display:flex;justify-content:space-around;gap:8px;font:400 .68rem var(--mono);color:var(--text-muted);padding-top:30px}.frontend-layouts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px;margin:45px 0 32px}.frontend-layouts h3{margin:22px 0 14px}.frontend-layouts p{color:var(--text-muted);font-size:.94rem}.layout-visual{height:150px;background:var(--surface);padding:24px;border-radius:12px;display:flex;gap:10px;align-items:center}.visual-grid i{height:95px;flex:1;border-radius:5px;background:linear-gradient(150deg,#383e2c,#1c1e18);position:relative}.visual-grid i:after{content:"";position:absolute;bottom:15px;left:10px;right:10px;height:5px;background:#666d54;border-radius:3px}.visual-editorial i{width:47%;height:100%;border-radius:5px;background:#30382a}.visual-editorial>div{flex:1}.visual-editorial b{display:block;height:6px;border-radius:2px;background:#38383d;margin:12px 0}.visual-editorial b:first-child{background:#70716a;width:80%}.visual-code code{font-size:.76rem;line-height:1.7;overflow-wrap:anywhere;color:#c2cd9c}.integrations .m-copy{margin:0 0 18px}.integrations .m-link{display:inline-block;margin-top:24px}.features-cta{padding-top:50px;padding-bottom:100px;text-align:center}.features-cta .m-title{margin:auto}.features-cta .m-actions{justify-content:center}@media(max-width:900px){.features-hero{gap:36px;grid-template-columns:1fr 1fr}.feature-map{padding:25px 10px}.map-grid span{font-size:.76rem;padding:14px 7px}.frontend-layouts{gap:20px}}@media(max-width:700px){.features-hero{grid-template-columns:1fr;padding-top:70px;padding-bottom:70px}.features-hero h1{font-size:clamp(2.7rem,10vw,4rem)}.feature-map{max-width:500px;width:100%;margin:auto}.frontend-layouts{grid-template-columns:1fr;gap:34px}.layout-visual{max-width:440px}.features-cta{padding-bottom:70px}}</style>
