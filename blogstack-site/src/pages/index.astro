---
import Layout from "../layouts/Layout.astro";
import PricingPlans from "../components/PricingPlans.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Audiences from "../components/Audiences.astro";
import ArticleGraphic from "../components/ArticleGraphic.astro";
import BuyerQuestions from "../components/BuyerQuestions.astro";
import GrowthTools from "../components/GrowthTools.astro";
import LiveDemo from "../components/LiveDemo.astro";
import PublishingFlow from "../components/PublishingFlow.astro";
import PublishingOwnership from "../components/PublishingOwnership.astro";
import AiAssistance from "../components/AiAssistance.astro";
import SetupAssistant from "../components/SetupAssistant.astro";
import Hosting from "../components/Hosting.astro";
import { PLANS } from "@blogstack/core";
import { ACCESS_URL, ACCESS_LABEL, DEMO_URL, DOCS_URL } from "../lib/site";
---

<Layout
  title="BlogStack | Add a blog to your existing website"
  description="Write in BlogStack and publish at yoursite.com/blog. Get editable blog pages, private drafts, SEO checks, and reader analytics. Managed hosting or self-host on Cloudflare."
>
  <Navbar/>

  <main id="main-content">
    <div class="hero">
      <div class="hero-grid"></div>
      <div class="hero-glow"></div>

      <div class="hero-badge">
        <div class="hero-badge-dot"></div>
        Open-source blog publishing
      </div>

      <h1>Add a blog to<br /><em>the site you built.</em></h1>
      <p class="hero-sub">Write in BlogStack and publish at <strong>yoursite.com/blog</strong>. Edit the pages to match your design, then see how readers find your posts and which links they click.</p>
      <p class="hero-framework"><a href={DOCS_URL + "/docs/quickstart"}>Next.js starter</a>. <a href={DOCS_URL + "/docs/sdk"}>JavaScript SDK</a> and <a href={DOCS_URL + "/docs/api-reference"}>API</a> for other frameworks.</p>

      <div class="hero-actions">
        <a href={ACCESS_URL} class="btn btn-primary">Start free trial</a>
        <a href={DEMO_URL} class="btn btn-demo">See it on a live site <span aria-hidden="true">↗</span></a>
      </div>

      <div class="hero-code-preview">
        <div class="code-window">
          <div class="code-titlebar">
            <div class="code-dots">
              <div class="code-dot"></div>
              <div class="code-dot"></div>
              <div class="code-dot"></div>
            </div>
            <span class="code-filename">How BlogStack works</span>
            <div class="code-tabs">
              <button type="button" class="code-tab active" data-tab-target="editor" aria-controls="tab-editor" aria-pressed="true">Publish</button>
              <button type="button" class="code-tab" data-tab-target="sdk" aria-controls="tab-sdk" aria-pressed="false">Install</button>
              <button type="button" class="code-tab" data-tab-target="components" aria-controls="tab-components" aria-pressed="false">Components</button>
            </div>
          </div>
          <div id="tab-editor" class="tab-content active">
            <PublishingFlow />
          </div>
          <div id="tab-sdk" class="tab-content">
<pre>npm install @blogstack/sdk @blogstack/ui

1. Create a BlogStack project
2. Copy the Next.js reference routes
3. Set your project slug and website URL
4. Publish your first story

✓ Blog index and article pages at /blog
✓ Search metadata, sitemap and RSS
✓ Pages styled to match your site</pre>
          </div>
          <div id="tab-components" class="tab-content">
<pre><span class="t-keyword">import</span> { <span class="t-type">Blog</span> } <span class="t-keyword">from</span> <span class="t-str">'@/components/ui/blog'</span>

<span class="t-comment">// A complete blog, installed as editable source</span>
<span class="t-keyword">export default function</span> <span class="t-fn">BlogPage</span>() &#123;
  <span class="t-keyword">return</span> (
    &lt;<span class="t-type">Blog</span>
      <span class="t-prop">projectSlug</span>=<span class="t-str">"acme"</span>
      <span class="t-prop">title</span>=<span class="t-str">"Acme journal"</span>
      <span class="t-prop">layout</span>=<span class="t-str">"editorial"</span>
    /&gt;
  )
&#125;

<span class="t-comment">// Search, tags, pagination and article pages are included</span></pre>
          </div>
        </div>
      </div>
    </div>

    <div class="stats-bar">
      <div class="stat"><div class="stat-num">/blog</div><div class="stat-label">On your own domain</div></div>
      <div class="stat"><div class="stat-num">0</div><div class="stat-label">Redeploys to publish<br />with the Next.js starter</div></div>
      <div class="stat"><div class="stat-num">MIT</div><div class="stat-label">The whole platform</div></div>
      <div class="stat"><div class="stat-num">${PLANS.solo.monthly}</div><div class="stat-label">Cloud starting price per month</div></div>
      <div class="stat"><div class="stat-num">{PLANS.growth.storageBytes / 1e9} GB</div><div class="stat-label">Media storage on Growth</div></div>
    </div>

    <LiveDemo />
    <hr class="divider" />

    <Audiences/>

    <section id="components" class="reveal">
      <div class="section-label">How it works</div>
      <h2 class="section-title">Build the pages once.<br /><em>Publish from the editor.</em></h2>
      <p class="section-sub">Install the blog pages in your website, then use the publishing dashboard for posts, images, and edits. Everyday updates happen in the editor.</p>

      <div class="pillars">
        <div class="pillar">
          <div class="pillar-header"><div class="pillar-tag">@blogstack/ui</div><div class="pillar-num">01</div></div>
          <div class="pillar-body">
            <h3>Start with pages you can edit</h3>
            <p>Add a blog index and article pages, then adjust the fonts, spacing, and layout to match the rest of your website.</p>
            <div class="pillar-features">
              <div class="pillar-feature">Blog index and article pages</div>
              <div class="pillar-feature">Search, tags and pagination</div>
              <div class="pillar-feature">Loading, empty and retry states</div>
              <div class="pillar-feature">Editable Tailwind source</div>
              <div class="pillar-feature">Navigation in your own site</div>
              <div class="pillar-feature">Install individual components</div>
            </div>
          </div>
        </div>

        <div class="pillar">
          <div class="pillar-header"><div class="pillar-tag">@blogstack/sdk</div><div class="pillar-num">02</div></div>
          <div class="pillar-body">
            <h3>Serve articles from your website</h3>
            <p>Copy the Next.js routes for server-rendered articles. For another framework, fetch the same posts using the JavaScript SDK or public JSON API.</p>
            <div class="pillar-features">
              <div class="pillar-feature">Server, static, or client rendering</div>
              <div class="pillar-feature">Metadata and JSON-LD</div>
              <div class="pillar-feature">Sitemap and RSS generation</div>
              <div class="pillar-feature">Type-safe JavaScript SDK</div>
              <div class="pillar-feature">Edge-runtime compatible</div>
              <div class="pillar-feature">Public JSON API</div>
            </div>
          </div>
        </div>

        <div class="pillar">
          <div class="pillar-header"><div class="pillar-tag">Publishing dashboard</div><div class="pillar-num">03</div></div>
          <div class="pillar-body">
            <h3>Give each blog a place to write</h3>
            <p>Draft a new post or revise an existing one in private. When you’re ready, publish it yourself or invite editors to help.</p>
            <div class="pillar-features">
              <div class="pillar-feature">Author roles and invitations</div>
              <div class="pillar-feature">Permissions for each blog</div>
              <div class="pillar-feature">Bring your own comments</div>
              <div class="pillar-feature">Bring your own newsletter</div>
              <div class="pillar-feature">Analytics and AI assistance</div>
              <div class="pillar-feature">Manage multiple publications</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section class="reveal">
      <div class="section-label">Blog layouts</div>
      <h2 class="section-title">A layout for the way<br /><em>you write.</em></h2>
      <p class="section-sub">Your blog pages live in your own codebase. Set the routes, typography, and layout just as you do for the rest of your site. Start with a grid, a featured story, or a clean list.</p>

      <div class="component-preview-wrap">
        <div class="component-preview">
          <div class="component-toolbar">
            <div class="component-toolbar-left">
              <div class="toolbar-pill active">Grid layout</div>
              <div class="toolbar-pill">Featured</div>
              <div class="toolbar-pill">Minimal list</div>
            </div>
            <div class="component-preview-label">Layout preview · example content</div>
          </div>
          <div class="component-canvas">
            <div class="blog-cards-grid">
              <div class="blog-card-demo">
                <ArticleGraphic kind="routes" />
                <div class="blog-card-body">
                  <div class="blog-card-tag">Engineering</div>
                  <div class="blog-card-title">Publish a blog inside your own website</div>
                  <div class="blog-card-meta"><span>Mar 12</span><div class="blog-card-meta-dot"></div><span>8 min read</span></div>
                </div>
              </div>
              <div class="blog-card-demo">
                <ArticleGraphic kind="release" />
                <div class="blog-card-body">
                  <div class="blog-card-tag">Product</div>
                  <div class="blog-card-title">The story behind our latest release</div>
                  <div class="blog-card-meta"><span>Mar 8</span><div class="blog-card-meta-dot"></div><span>4 min read</span></div>
                </div>
              </div>
              <div class="blog-card-demo">
                <ArticleGraphic kind="draft" />
                <div class="blog-card-body">
                  <div class="blog-card-tag">Tutorial</div>
                  <div class="blog-card-title">Keep drafts private until they are ready</div>
                  <div class="blog-card-meta"><span>Feb 28</span><div class="blog-card-meta-dot"></div><span>12 min read</span></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section id="sdk" class="reveal">
      <div class="showcase-grid">
        <div class="showcase-info">
          <div class="section-label">Next.js integration</div>
          <h2 class="section-title showcase-title">Get your first post<br /><em>to /blog.</em></h2>
          <p class="section-sub showcase-sub">The Next.js starter includes an index, article pages, a sitemap, and RSS. Add the routes to your existing project and connect them to your BlogStack workspace.</p>

          <div class="showcase-step"><div class="step-num" aria-hidden="true">1</div><div class="step-content"><h4>Create a blog</h4><p>Choose a project slug and set the address your readers will visit.</p></div></div>
          <div class="showcase-step"><div class="step-num" aria-hidden="true">2</div><div class="step-content"><h4>Add the routes</h4><p>Copy the starter into your site and set the project slug and API URL.</p></div></div>
          <div class="showcase-step"><div class="step-num" aria-hidden="true">3</div><div class="step-content"><h4>Publish the first post</h4><p>Preview your draft in the editor, publish it, and open the article on your website.</p></div></div>
          <a class="m-link" href={DOCS_URL+"/docs/quickstart"}>Follow the Next.js quickstart</a>
        </div>

        <div class="code-window showcase-window">
          <div class="code-titlebar">
            <div class="code-dots"><div class="code-dot"></div><div class="code-dot"></div><div class="code-dot"></div></div>
            <span class="code-filename">.env.local</span>
          </div>
<pre>BLOGSTACK_PROJECT_SLUG=acme
BLOGSTACK_API_URL=https://blogstack-app.hidden-silence-2d18.workers.dev
SITE_URL=https://your-website.example

<span class="t-comment">// Native Next.js routes</span>
app/blog/page.tsx
app/blog/[slug]/page.tsx
app/blog/sitemap.xml/route.ts
app/blog/feed.xml/route.ts

<span class="t-comment">// Merge the blog sitemap into your existing robots config.</span></pre>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section id="editor" class="reveal">
      <div class="section-label">Publishing tools</div>
      <h2 class="section-title">Give every post<br /><em>a better chance to be read.</em></h2>

      <div class="feature-grid">
        <div class="feature-card"><svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg><h3>Write with images and code</h3><p>Put screenshots and examples right where they help. The editor supports image blocks, quotes, lists, and highlighted code.</p></div>
        <div class="feature-card"><svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg><h3>Preview your search result</h3><p>Set the title and description, choose a social image, and see which headings or image descriptions need attention.</p></div>
        <div class="feature-card"><svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8m-4-4v4"/></svg><h3>Keep your images together</h3><p>Upload cover art, screenshots, and illustrations in the dashboard. BlogStack serves them on your published pages.</p></div>
        <div class="feature-card"><svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2a10 10 0 1010 10A10 10 0 0012 2zm0 0v10l6 3"/></svg><h3>Revise a post in private</h3><p>Save edits as a draft and preview them. Readers see the published version until you send the update live.</p></div>
        <div class="feature-card"><svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a4 4 0 01-4 4H8l-5 3V7a4 4 0 014-4h10a4 4 0 014 4z"/></svg><h3>Make room for replies</h3><p>Place a comments component from your provider below an article.</p></div>
        <div class="feature-card"><svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16v16H4z"/><path d="m4 7 8 6 8-6"/></svg><h3>Let readers subscribe</h3><p>Place your newsletter signup form on the blog. Your email provider handles the list and sends the newsletter.</p></div>
      </div>
    </section>

    <hr class="divider" />

    <GrowthTools/>
    <div class="m-rule"></div>
    <AiAssistance/>
    <div class="m-rule"></div>
    <SetupAssistant/>
    <div class="m-rule"></div>
    <PublishingOwnership/>
    <div class="m-rule"></div>
    <Hosting/>
    <div class="m-rule"></div>

    <section id="pricing" class="reveal">
      <div class="pricing-intro">
        <div class="section-label pricing-label">BlogStack Cloud pricing</div>
        <h2 class="section-title">One blog or <em>an entire portfolio.</em></h2>
        <p class="section-sub pricing-sub">Solo covers one blog. Studio and Growth include unlimited blogs and custom branding, and Growth has {PLANS.growth.storageBytes / 1e9} GB for media.</p>
      </div>

      <PricingPlans/>
    </section>

    <hr class="divider" />

    <BuyerQuestions/>
    <div class="m-rule"></div>

    <div class="cta-section reveal">
      <h2>Publish your first post<br /><em>on your own site.</em></h2>
      <p>Try BlogStack Cloud for 14 days without a card, or read the quickstart and see how the pages fit into your project.</p>
      <div class="cta-actions-row">
        <a href={ACCESS_URL} class="btn btn-primary cta-btn">{ACCESS_LABEL}</a>
        <a href={DOCS_URL+"/docs/quickstart"} class="btn btn-ghost cta-btn">Read the quickstart</a>
      </div>
    </div>
  </main>

  <Footer/>

  <style is:global>
    .landing-nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 40px;
      height: 56px;
      border-bottom: 1px solid var(--border);
      background: rgba(9, 9, 11, 0.85);
      backdrop-filter: blur(12px);
    }

    .nav-logo {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: var(--mono);
      font-size: 14px;
      font-weight: 500;
      letter-spacing: -0.02em;
    }

    .dot {
      width: 7px;
      height: 7px;
      background: var(--accent);
      border-radius: 50%;
      animation: pulse 2s ease-in-out infinite;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 32px;
      list-style: none;
    }

    .nav-links a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 13px;
      transition: color 0.15s;
    }

    .nav-links a:hover,
    .footer-links a:hover {
      color: var(--text);
    }

    .nav-cta {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 7px 16px;
      border-radius: 6px;
      font-size: 13px;
      font-family: var(--sans);
      font-weight: 500;
      cursor: pointer;
      transition: all 0.15s;
      text-decoration: none;
      border: none;
      white-space: nowrap;
    }

    .btn-ghost {
      background: transparent;
      color: var(--text-muted);
      border: 1px solid var(--border);
    }

    .btn-ghost:hover {
      color: var(--text);
      border-color: var(--border-light);
    }

    .btn-primary {
      background: var(--accent);
      color: #000;
      font-weight: 600;
    }

    .btn-primary:hover {
      background: var(--accent-dim);
      transform: translateY(-1px);
    }

    .hero {
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 80px 40px 64px;
      position: relative;
      text-align: center;
      overflow: hidden;
    }

    .hero-grid {
      position: absolute;
      inset: 0;
      background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px);
      background-size: 60px 60px;
      opacity: 0.3;
      mask-image: radial-gradient(ellipse 80% 60% at 50% 50%, black 20%, transparent 100%);
    }

    .hero-glow {
      position: absolute;
      width: 600px;
      height: 400px;
      background: radial-gradient(ellipse, rgba(232, 255, 71, 0.07) 0%, transparent 70%);
      top: 20%;
      left: 50%;
      transform: translateX(-50%);
      pointer-events: none;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px 4px 6px;
      border: 1px solid rgba(232, 255, 71, 0.3);
      border-radius: 100px;
      background: var(--accent-subtle);
      font-family: var(--mono);
      font-size: 11px;
      color: var(--accent);
      margin-bottom: 32px;
      animation: fadeUp 0.6s ease both;
      letter-spacing: 0.04em;
    }

    .hero-badge-dot {
      width: 5px;
      height: 5px;
      background: var(--accent);
      border-radius: 50%;
      flex-shrink: 0;
    }

    .hero h1 {
      font-family: var(--serif);
      font-size: clamp(52px, 8vw, 96px);
      font-weight: 400;
      line-height: 1;
      letter-spacing: -0.02em;
      max-width: 900px;
      animation: fadeUp 0.6s 0.1s ease both;
      position: relative;
    }

    .hero h1 em,
    .section-title em,
    .cta-section h2 em {
      font-style: italic;
      color: var(--accent);
    }

    .hero-sub {
      font-size: 17px;
      color: var(--text-muted);
      max-width: 520px;
      margin: 24px auto 14px;
      line-height: 1.7;
      animation: fadeUp 0.6s 0.2s ease both;
    }

    .hero-framework {
      margin: 0 auto 32px;
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.9;
      text-wrap: balance;
    }

    .hero-framework a {
      color: var(--text);
      text-decoration: underline;
      text-decoration-color: var(--border-light);
      text-underline-offset: 4px;
    }

    .hero-framework a:hover {
      text-decoration-color: var(--accent);
    }

    .btn-demo {
      border: 1px solid var(--border-light);
      background: var(--surface-2);
      color: var(--text);
    }

    .btn-demo span {
      margin-inline-start: 4px;
      color: var(--accent);
    }

    .btn-demo:hover {
      border-color: var(--accent);
    }

    .hero-actions,
    .cta-actions-row {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .hero-actions {
      animation: fadeUp 0.6s 0.3s ease both;
    }

    .hero-actions .btn,
    .cta-btn {
      padding: 10px 22px;
      font-size: 14px;
    }

    .hero-code-preview {
      margin-top: 56px;
      width: 100%;
      max-width: 860px;
      position: relative;
    }

    .code-window,
    .component-preview {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      text-align: left;
      box-shadow: 0 40px 80px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.03);
    }

    .code-titlebar,
    .component-toolbar {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 12px 16px;
      border-bottom: 1px solid var(--border);
      background: var(--surface-2);
    }

    .code-dots {
      display: flex;
      gap: 6px;
    }

    .code-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }

    .code-dot:nth-child(1) { background: #ff5f56; }
    .code-dot:nth-child(2) { background: #ffbd2e; }
    .code-dot:nth-child(3) { background: #27c93f; }

    .code-filename,
    .component-preview-label,
    .toolbar-pill,
    .pricing-plan,
    .footer-copy,
    code {
      font-family: var(--mono);
    }

    .code-filename,
    .component-preview-label {
      font-size: 11px;
      color: var(--text-muted);
    }

    .code-tabs {
      display: flex;
      gap: 0;
      margin-left: auto;
    }

    .code-tab,
    .toolbar-pill {
      font-size: 11px;
      padding: 4px 12px;
      border-radius: 4px;
      color: var(--text-muted);
      transition: all 0.15s;
      border: 1px solid transparent;
      background: transparent;
    }

    .code-tab {
      cursor: pointer;
    }

    .code-tab.active,
    .toolbar-pill.active,
    .toolbar-pill:hover {
      color: var(--accent);
      background: var(--accent-subtle);
      border-color: rgba(232, 255, 71, 0.2);
    }

    pre {
      padding: 24px;
      font-family: var(--mono);
      font-size: 13px;
      line-height: 1.8;
      overflow-x: auto;
      color: #a1a1aa;
      margin: 0;
    }

    .t-keyword { color: #c084fc; }
    .t-fn { color: #60a5fa; }
    .t-str { color: #86efac; }
    .t-comment { color: #3f3f46; }
    .t-type { color: #fbbf24; }
    .t-var { color: var(--text); }
    .t-accent { color: var(--accent); }
    .t-prop { color: #f9a8d4; }

    section {
      padding: 100px 40px;
      max-width: 1120px;
      margin: 0 auto;
    }

