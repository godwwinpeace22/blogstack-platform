---
import Layout from "../layouts/Layout.astro";
import PricingPlans from "../components/PricingPlans.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Audiences from "../components/Audiences.astro";
import AiAssistance from "../components/AiAssistance.astro";
import SetupAssistant from "../components/SetupAssistant.astro";
import Hosting from "../components/Hosting.astro";
import { ACCESS_URL, ACCESS_LABEL, DEMO_URL } from "../lib/site";
---

<Layout
  title="BlogStack — Add a complete blog to any website"
  description="A blog for your personal website, company publication or client projects. Native components, a focused editor, SEO, analytics and AI assistance."
>
  <Navbar/>

  <main id="main-content">
    <div class="hero">
      <div class="hero-grid"></div>
      <div class="hero-glow"></div>

      <div class="hero-badge">
        <div class="hero-badge-dot"></div>
        For personal blogs, teams and client projects
      </div>

      <h1>Add a complete blog<br />to <em>any website</em></h1>
      <p class="hero-sub">Share what you know. Tell your company’s story. Build a publication that feels at home on your website, with an editor you’ll enjoy using and a stack you control.</p>

      <div class="hero-actions">
        <a href={ACCESS_URL} class="btn btn-primary">Start free trial</a>
        <a href={DEMO_URL} class="btn btn-ghost">Explore the live blog</a>
      </div>

      <div class="hero-code-preview">
        <div class="code-window">
          <div class="code-titlebar">
            <div class="code-dots">
              <div class="code-dot"></div>
              <div class="code-dot"></div>
              <div class="code-dot"></div>
            </div>
            <span class="code-filename">blog.tsx</span>
            <div class="code-tabs">
              <button type="button" class="code-tab active" data-tab-target="sdk">Install</button>
              <button type="button" class="code-tab" data-tab-target="components">Components</button>
              <button type="button" class="code-tab" data-tab-target="editor">Publish</button>
            </div>
          </div>
          <div id="tab-sdk" class="tab-content active">
<pre>npm install @blogstack/sdk @blogstack/ui

1. Create a BlogStack project
2. Copy the Next.js reference routes
3. Set your project slug and website URL
4. Publish your first story

✓ Native blog index and article pages
✓ Metadata, JSON-LD, sitemap and RSS
✓ Your website, domain and design</pre>
          </div>
          <div id="tab-components" class="tab-content">
<pre><span class="t-keyword">import</span> { <span class="t-type">Blog</span> } <span class="t-keyword">from</span> <span class="t-str">'@/components/ui/blog'</span>

<span class="t-comment">// A complete blog, installed as editable source</span>
<span class="t-keyword">export default function</span> <span class="t-fn">BlogPage</span>() &#123;
  <span class="t-keyword">return</span> (
    &lt;<span class="t-type">Blog</span>
      <span class="t-prop">projectSlug</span>=<span class="t-str">"acme"</span>
      <span class="t-prop">title</span>=<span class="t-str">"Acme journal"</span>
      <span class="t-prop">layout</span>=<span class="t-str">"editorial"</span>
    /&gt;
  )
&#125;

<span class="t-comment">// Search, tags, pagination and article pages are included</span></pre>
          </div>
          <div id="tab-editor" class="tab-content">
<pre>In the BlogStack dashboard:

Write on your own, or add your team.
Project → Members → Invite an author

✓ A focused workspace for every publication
✓ Choose who can write, edit and publish
✓ Autosaves remain private drafts
✓ Publishing requires an explicit action

Studio and Growth:
Use your own workspace name and logo</pre>
          </div>
        </div>
      </div>
    </div>

    <div class="stats-bar">
      <div class="stat"><div class="stat-num">3</div><div class="stat-label">Complete templates</div></div>
      <div class="stat"><div class="stat-num">MIT</div><div class="stat-label">The complete platform</div></div>
      <div class="stat"><div class="stat-num">Any</div><div class="stat-label">Fetch-compatible host</div></div>
      <div class="stat"><div class="stat-num">100%</div><div class="stat-label">Source-owned UI</div></div>
      <div class="stat"><div class="stat-num">0</div><div class="stat-label">Iframes required</div></div>
    </div>

    <hr class="divider" />

    <Audiences/>

    <section id="components" class="reveal">
      <div class="section-label">// What you get</div>
      <h2 class="section-title">Everything a publication needs.<br /><em>One connected stack.</em></h2>
      <p class="section-sub">The parts you need to build, write and grow a blog. Your frontend stays in your codebase. Publishing, media and content delivery work together in BlogStack.</p>

      <div class="pillars">
        <div class="pillar">
          <div class="pillar-header"><div class="pillar-tag">@blogstack/ui</div><div class="pillar-num">01</div></div>
          <div class="pillar-body">
            <h3>A complete, editable blog</h3>
            <p>Install production-ready React pages styled with Tailwind. Start with the whole experience, then change any source you need.</p>
            <div class="pillar-features">
              <div class="pillar-feature">Blog index and article pages</div>
              <div class="pillar-feature">Search, tags and pagination</div>
              <div class="pillar-feature">Loading, empty and retry states</div>
              <div class="pillar-feature">Editable Tailwind source</div>
              <div class="pillar-feature">Host-owned routes and links</div>
              <div class="pillar-feature">Optional supporting components</div>
            </div>
          </div>
        </div>

        <div class="pillar">
          <div class="pillar-header"><div class="pillar-tag">@blogstack/sdk</div><div class="pillar-num">02</div></div>
          <div class="pillar-body">
            <h3>Framework-native integration</h3>
            <p>Start with the Next.js reference integration for native routes and server rendering. The public JavaScript client works in any Fetch-compatible environment.</p>
            <div class="pillar-features">
              <div class="pillar-feature">SSR, SSG or client rendering</div>
              <div class="pillar-feature">Metadata and JSON-LD</div>
              <div class="pillar-feature">Sitemap and RSS generation</div>
              <div class="pillar-feature">Type-safe JavaScript SDK</div>
              <div class="pillar-feature">Edge-runtime compatible</div>
              <div class="pillar-feature">Headless escape hatch</div>
            </div>
          </div>
        </div>

        <div class="pillar">
          <div class="pillar-header"><div class="pillar-tag">BlogStack Cloud</div><div class="pillar-num">03</div></div>
          <div class="pillar-body">
            <h3>A workspace for your publication</h3>
            <p>Write for yourself or bring your authors together. Manage drafts, media, search appearance and publishing from one focused workspace.</p>
            <div class="pillar-features">
              <div class="pillar-feature">Author roles and invitations</div>
              <div class="pillar-feature">Access scoped to each publication</div>
              <div class="pillar-feature">Comments integration slot</div>
              <div class="pillar-feature">Newsletter integration slot</div>
              <div class="pillar-feature">Analytics and AI assistance</div>
              <div class="pillar-feature">Manage multiple publications</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section class="reveal">
      <div class="section-label">// Native frontend</div>
      <h2 class="section-title">Looks like your website.<br /><em>Because it is.</em></h2>
      <p class="section-sub">Real routes, real markup, and editable Tailwind source inside the application. No iframe and no separately themed hosted blog.</p>

      <div class="component-preview-wrap">
        <div class="component-preview">
          <div class="component-toolbar">
            <div class="component-toolbar-left">
              <div class="toolbar-pill active">Grid layout</div>
              <div class="toolbar-pill">Featured</div>
              <div class="toolbar-pill">Minimal list</div>
            </div>
            <div class="component-preview-label">Layout preview · example content</div>
          </div>
          <div class="component-canvas">
            <div class="blog-cards-grid">
              <div class="blog-card-demo">
                <div class="blog-card-img"><div class="blog-card-img-pattern"></div></div>
                <div class="blog-card-body">
                  <div class="blog-card-tag">Engineering</div>
                  <div class="blog-card-title">Publish a blog inside your own website</div>
                  <div class="blog-card-meta"><span>Mar 12</span><div class="blog-card-meta-dot"></div><span>8 min read</span></div>
                </div>
              </div>
              <div class="blog-card-demo">
                <div class="blog-card-img blog-card-img-blue"><div class="blog-card-img-pattern"></div></div>
                <div class="blog-card-body">
                  <div class="blog-card-tag">Product</div>
                  <div class="blog-card-title">The story behind our latest release</div>
                  <div class="blog-card-meta"><span>Mar 8</span><div class="blog-card-meta-dot"></div><span>4 min read</span></div>
                </div>
              </div>
              <div class="blog-card-demo">
                <div class="blog-card-img blog-card-img-green"><div class="blog-card-img-pattern"></div></div>
                <div class="blog-card-body">
                  <div class="blog-card-tag">Tutorial</div>
                  <div class="blog-card-title">Keep drafts private until they are ready</div>
                  <div class="blog-card-meta"><span>Feb 28</span><div class="blog-card-meta-dot"></div><span>12 min read</span></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section id="sdk" class="reveal">
      <div class="showcase-grid">
        <div class="showcase-info">
          <div class="section-label">// Next.js integration</div>
          <h2 class="section-title showcase-title">Use your framework.<br /><em>Keep your routes.</em></h2>
          <p class="section-sub showcase-sub">The public JavaScript client works independently of a framework. Start with the complete Next.js example for native routes and server-rendered articles.</p>

          <div class="showcase-step"><div class="step-num">1</div><div class="step-content"><h4>Choose the existing site</h4><p>Connect your public project slug and set the blog URL in project settings.</p></div></div>
          <div class="showcase-step"><div class="step-num">2</div><div class="step-content"><h4>Generate the complete blog</h4><p>Use the Next.js reference integration for article routes, SEO metadata, sitemap and RSS.</p></div></div>
          <div class="showcase-step"><div class="step-num">3</div><div class="step-content"><h4>Make it yours</h4><p>Match your design, publish your first article, and invite other authors whenever you need them.</p></div></div>
        </div>

        <div class="code-window showcase-window">
          <div class="code-titlebar">
            <div class="code-dots"><div class="code-dot"></div><div class="code-dot"></div><div class="code-dot"></div></div>
            <span class="code-filename">blogstack.config.ts</span>
          </div>
<pre>BLOGSTACK_PROJECT_SLUG=acme
BLOGSTACK_API_URL=https://blogstack-app.hidden-silence-2d18.workers.dev
SITE_URL=https://your-website.example

<span class="t-comment">// Native Next.js routes</span>
app/blog/page.tsx
app/blog/[slug]/page.tsx
app/blog/sitemap.xml/route.ts
app/blog/feed.xml/route.ts

<span class="t-comment">// Merge the blog sitemap into your existing robots config.</span></pre>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section id="editor" class="reveal">
      <div class="section-label">// Complete publication</div>
      <h2 class="section-title">Content, audience, and operations.<br /><em>Handled together.</em></h2>

      <div class="feature-grid">
        <div class="feature-card"><svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg><h3>Rich text editor</h3><p>Write with images, headings, lists, quotes and highlighted code in the hosted publishing dashboard.</p></div>
        <div class="feature-card"><svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg><h3>SEO metadata</h3><p>Built-in title, description, OG image, and canonical URL fields. Auto-generates structured data JSON-LD.</p></div>
        <div class="feature-card"><svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8m-4-4v4"/></svg><h3>Media library</h3><p>Upload and manage images up to 10 MiB each, with shared account storage and CDN delivery.</p></div>
        <div class="feature-card"><svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2a10 10 0 1010 10A10 10 0 0012 2zm0 0v10l6 3"/></svg><h3>Safe drafts</h3><p>Save revisions privately and publish when ready. Your live article stays unchanged while you edit.</p></div>
        <div class="feature-card"><svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg><h3>AI writing assist</h3><p>Generate outlines, expand bullet points, improve tone, and auto-generate meta descriptions.</p></div>
        <div class="feature-card"><svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg><h3>Analytics</h3><p>Page views, referrer domains and article-link clicks, with opt-out and clearly labeled estimates.</p></div>
        <div class="feature-card"><svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a4 4 0 01-4 4H8l-5 3V7a4 4 0 014-4h10a4 4 0 014 4z"/></svg><h3>Comments</h3><p>Bring your own comments component through a named integration slot. Provider accounts and fees are separate.</p></div>
        <div class="feature-card"><svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16v16H4z"/><path d="m4 7 8 6 8-6"/></svg><h3>Newsletter</h3><p>Add a subscription form from your email provider through the newsletter slot. Delivery and subscriber management stay with your provider.</p></div>
        <div class="feature-card"><svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 9h8M8 15h8"/><rect x="3" y="3" width="18" height="18" rx="4"/></svg><h3>API and reviewable AI</h3><p>Let writing, SEO and linking assistants prepare changes for review. Publishing stays in your control.</p></div>
      </div>
    </section>

    <hr class="divider" />

    <AiAssistance/>
    <div class="m-rule"></div>
    <SetupAssistant/>
    <div class="m-rule"></div>
    <Hosting/>
    <div class="m-rule"></div>

    <section id="pricing" class="reveal">
      <div class="pricing-intro">
        <div class="section-label pricing-label">// Pricing</div>
        <h2 class="section-title">Simple, <em>honest</em> pricing</h2>
        <p class="section-sub pricing-sub">No seat fees. No surprise overages. Scale as you grow.</p>
      </div>

      <PricingPlans/>
    </section>

    <hr class="divider" />

    <div class="cta-section reveal">
      <h2>Your blog.<br /><em>Your stack.</em></h2>
      <p>Your next idea deserves more than a draft. Give it a place on your website.</p>
      <div class="cta-actions-row">
        <a href={ACCESS_URL} class="btn btn-primary cta-btn">{ACCESS_LABEL}</a>
        <a href="https://blogstack-docs.hidden-silence-2d18.workers.dev" class="btn btn-ghost cta-btn">Read the docs</a>
      </div>
    </div>
  </main>

  <Footer/>

  <style is:global>
    .landing-nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 40px;
      height: 56px;
      border-bottom: 1px solid var(--border);
      background: rgba(9, 9, 11, 0.85);
      backdrop-filter: blur(12px);
    }

    .nav-logo {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: var(--mono);
      font-size: 14px;
      font-weight: 500;
      letter-spacing: -0.02em;
    }

    .dot {
      width: 7px;
      height: 7px;
      background: var(--accent);
      border-radius: 50%;
      animation: pulse 2s ease-in-out infinite;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 32px;
      list-style: none;
    }

    .nav-links a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 13px;
      transition: color 0.15s;
    }

    .nav-links a:hover,
    .footer-links a:hover {
      color: var(--text);
    }

    .nav-cta {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 7px 16px;
      border-radius: 6px;
      font-size: 13px;
      font-family: var(--sans);
      font-weight: 500;
      cursor: pointer;
      transition: all 0.15s;
      text-decoration: none;
      border: none;
      white-space: nowrap;
    }

    .btn-ghost {
      background: transparent;
      color: var(--text-muted);
      border: 1px solid var(--border);
    }

    .btn-ghost:hover {
      color: var(--text);
      border-color: var(--border-light);
    }

    .btn-primary {
      background: var(--accent);
      color: #000;
      font-weight: 600;
    }

    .btn-primary:hover {
      background: var(--accent-dim);
      transform: translateY(-1px);
    }

    .hero {
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 80px 40px 64px;
      position: relative;
      text-align: center;
      overflow: hidden;
    }

    .hero-grid {
      position: absolute;
      inset: 0;
      background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px);
      background-size: 60px 60px;
      opacity: 0.3;
      mask-image: radial-gradient(ellipse 80% 60% at 50% 50%, black 20%, transparent 100%);
    }

    .hero-glow {
      position: absolute;
      width: 600px;
      height: 400px;
      background: radial-gradient(ellipse, rgba(232, 255, 71, 0.07) 0%, transparent 70%);
      top: 20%;
      left: 50%;
      transform: translateX(-50%);
      pointer-events: none;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px 4px 6px;
      border: 1px solid rgba(232, 255, 71, 0.3);
      border-radius: 100px;
      background: var(--accent-subtle);
      font-family: var(--mono);
      font-size: 11px;
      color: var(--accent);
      margin-bottom: 32px;
      animation: fadeUp 0.6s ease both;
      letter-spacing: 0.04em;
    }

    .hero-badge-dot {
      width: 5px;
      height: 5px;
      background: var(--accent);
      border-radius: 50%;
      flex-shrink: 0;
    }

    .hero h1 {
      font-family: var(--serif);
      font-size: clamp(52px, 8vw, 96px);
      font-weight: 400;
      line-height: 1;
      letter-spacing: -0.02em;
      max-width: 900px;
      animation: fadeUp 0.6s 0.1s ease both;
      position: relative;
    }

    .hero h1 em,
    .section-title em,
    .cta-section h2 em {
      font-style: italic;
      color: var(--accent);
    }

    .hero-sub {
      font-size: 17px;
      color: var(--text-muted);
      max-width: 520px;
      margin: 24px auto 40px;
      line-height: 1.7;
      animation: fadeUp 0.6s 0.2s ease both;
    }

    .hero-actions,
    .cta-actions-row {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .hero-actions {
      animation: fadeUp 0.6s 0.3s ease both;
    }

    .hero-actions .btn,
    .cta-btn {
      padding: 10px 22px;
      font-size: 14px;
    }

    .hero-code-preview {
      margin-top: 80px;
      width: 100%;
      max-width: 860px;
      animation: fadeUp 0.8s 0.4s ease both;
      position: relative;
    }

    .code-window,
    .component-preview {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      text-align: left;
      box-shadow: 0 40px 80px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.03);
    }

    .code-titlebar,
    .component-toolbar {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 12px 16px;
      border-bottom: 1px solid var(--border);
      background: var(--surface-2);
    }

    .code-dots {
      display: flex;
      gap: 6px;
    }

    .code-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }

    .code-dot:nth-child(1) { background: #ff5f56; }
    .code-dot:nth-child(2) { background: #ffbd2e; }
    .code-dot:nth-child(3) { background: #27c93f; }

    .code-filename,
    .component-preview-label,
    .toolbar-pill,
    .pricing-plan,
    .footer-copy,
    code {
      font-family: var(--mono);
    }

    .code-filename,
    .component-preview-label {
      font-size: 11px;
      color: var(--text-muted);
    }

    .code-tabs {
      display: flex;
      gap: 0;
      margin-left: auto;
    }

    .code-tab,
    .toolbar-pill {
      font-size: 11px;
      padding: 4px 12px;
      border-radius: 4px;
      color: var(--text-muted);
      transition: all 0.15s;
      border: 1px solid transparent;
      background: transparent;
    }

    .code-tab {
      cursor: pointer;
    }

    .code-tab.active,
    .toolbar-pill.active,
    .toolbar-pill:hover {
      color: var(--accent);
      background: var(--accent-subtle);
      border-color: rgba(232, 255, 71, 0.2);
    }

    pre {
      padding: 24px;
      font-family: var(--mono);
      font-size: 13px;
      line-height: 1.8;
      overflow-x: auto;
      color: #a1a1aa;
      margin: 0;
    }

    .t-keyword { color: #c084fc; }
    .t-fn { color: #60a5fa; }
    .t-str { color: #86efac; }
    .t-comment { color: #3f3f46; }
    .t-type { color: #fbbf24; }
    .t-var { color: var(--text); }
    .t-accent { color: var(--accent); }
    .t-prop { color: #f9a8d4; }

    section {
      padding: 100px 40px;
      max-width: 1120px;
      margin: 0 auto;
    }

    .section-label {
      font-family: var(--mono);
      font-size: 11px;
      color: var(--accent);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 16px;
    }

    .section-title {
      font-family: var(--serif);
      font-size: clamp(36px, 5vw, 56px);
      font-weight: 400;
      line-height: 1.1;
      letter-spacing: -0.02em;
      margin-bottom: 20px;
    }

    .section-sub,
    .step-content p,
    .cta-section p {
      color: var(--text-muted);
      font-size: 16px;
      line-height: 1.7;
    }

    .section-sub {
      max-width: 480px;
