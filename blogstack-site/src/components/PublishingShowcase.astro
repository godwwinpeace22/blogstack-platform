---
import { ACCESS_URL } from "../lib/site";
---
<section class="m-section" id="publishing" aria-labelledby="publishing-title">
  <div class="m-split">
    <figure class="m-shell editor-example">
      <img
        src="/images/editor-preview.webp"
        width="1168"
        height="650"
        alt="A draft open in the BlogStack editor, with preview, publish, and search appearance controls"
        loading="lazy"
        decoding="async"
      />
      <figcaption class="m-small">The BlogStack editor with an example draft</figcaption>
    </figure>
    <div>
      <h2 class="m-title" id="publishing-title">Dashboard</h2>
      <p class="m-copy">Write with images, code, quotes, and headings. Preview a draft before publishing it to your website. Readers see the current article while you work on the next version.</p>
      <div class="publishing-points">
        <p><strong>Roles and invitations</strong><br/><span>Give collaborators access to the blogs they work on.</span></p>
        <p><strong>Content and media export</strong><br/><span>Export posts, drafts, tags, and images.</span></p>
      </div>
      <div class="m-actions"><a class="m-button" href={ACCESS_URL}>Start writing</a></div>
    </div>
  </div>
</section>
<style>
  .editor-example { margin: 0; }
  .editor-example img { display: block; width: 100%; height: auto; border-radius: 8px; background: #fff; }
  .editor-example figcaption { padding: 11px 9px 6px; }
  .publishing-points { margin-top: 28px; display: grid; gap: 18px; }
  .publishing-points strong { font-weight: 500; }
  .publishing-points span { color: var(--text-muted); font-size: .92rem; }
</style>
