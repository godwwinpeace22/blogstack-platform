---
const features = [
  {
    icon: "editor",
    title: "Complete native blog",
    desc: "Install index and article pages, search, tags, pagination, metadata, JSON-LD, sitemap, and RSS into the existing website.",
  },
  {
    icon: "edge",
    title: "Native Next.js routes",
    desc: "Start with the complete Next.js reference and a framework-independent public JavaScript client.",
  },
  {
    icon: "sdk",
    title: "Write alone or with a team",
    desc: "Invite authors, editors or clients into a focused publishing workspace with project-scoped roles.",
  },
  {
    icon: "media",
    title: "Managed publishing cloud",
    desc: "Use private drafts, explicit publishing, media delivery and shared account allowances.",
  },
  {
    icon: "webhooks",
    title: "Comments and newsletters",
    desc: "Add comments components and newsletter forms from your own providers through named slots.",
  },
  {
    icon: "api",
    title: "API and reviewable AI",
    desc: "Use scoped APIs and writing, SEO and linking assistants that prepare proposals for human review.",
  },
];
---

<section class="features" id="features">
  <div class="features-inner">
    <div class="section-label">What you get</div>
    <h2 class="section-heading">Everything you need.<br />Nothing you don't.</h2>
    <p class="section-sub">
      Your website keeps its design and routes. BlogStack connects the writing, publishing
      and discovery tools for your personal blog, company publication or client work.
    </p>

    <div class="features-grid">
      {features.map((f) => (
        <div class="feature-card">
          <div class="feature-icon" data-icon={f.icon}>
            {f.icon === "api" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 6l4-4 4 4M8 18l4 4 4-4M4 12h16" stroke-linecap="round" stroke-linejoin="round"/></svg>}
            {f.icon === "edge" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" stroke-linecap="round"/></svg>}
            {f.icon === "editor" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" stroke-linecap="round" stroke-linejoin="round"/></svg>}
            {f.icon === "media" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21" stroke-linecap="round" stroke-linejoin="round"/></svg>}
            {f.icon === "webhooks" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M18 20a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM6 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM6 20a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/><path d="M18 17H9a3 3 0 0 1-3-3V8M6 5h8a3 3 0 0 1 3 3v6" stroke-linecap="round" stroke-linejoin="round"/></svg>}
            {f.icon === "sdk" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>}
          </div>
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-desc">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    padding: 5rem 1.5rem;
    background: linear-gradient(180deg, transparent, rgba(124, 106, 247, 0.04) 50%, transparent);
  }

  .features-inner {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
  }

  .section-label {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .section-heading {
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .section-sub {
    font-size: 1.0625rem;
    color: var(--color-muted);
    max-width: 520px;
    margin: 0 auto 3.5rem;
    line-height: 1.7;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    text-align: left;
  }

  .feature-card {
    background: #0e0e16;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.75rem;
    transition: border-color 0.2s;
  }
  .feature-card:hover {
    border-color: rgba(124, 106, 247, 0.4);
  }

  .feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: rgba(124, 106, 247, 0.12);
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }

  .feature-title {
    font-size: 1.0625rem;
    font-weight: 600;
    margin-bottom: 0.625rem;
    letter-spacing: -0.01em;
  }

  .feature-desc {
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.65;
  }
</style>
