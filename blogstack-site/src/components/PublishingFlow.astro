---
import ArticleGraphic from "./ArticleGraphic.astro";
---
<figure class="publishing-flow" aria-label="Example showing a draft in BlogStack and the same article published on the customer’s website">
  <div class="flow-content">
    <div class="flow-editor">
      <div class="flow-top"><span>BlogStack editor</span><span class="draft-indicator">Draft saved</span></div>
      <div class="flow-writing">
        <p class="flow-title">What changed in our July release</p>
        <p class="flow-text">A shorter setup flow, faster search, and three improvements shaped by reader feedback.</p>
        <div class="flow-seo"><span>Search preview</span><span>Ready to review</span></div>
        <div class="flow-publish">Publish article</div>
      </div>
    </div>
    <div class="flow-connector" aria-hidden="true"><span></span></div>
    <div class="flow-site">
      <div class="flow-top"><span>yoursite.com/blog</span><span class="live-indicator">Published</span></div>
      <ArticleGraphic kind="release" />
      <div class="flow-story">
        <p class="story-title">What changed in our July release</p>
        <p>Field Notes · Product updates</p>
      </div>
    </div>
  </div>
  <figcaption>Example publication using the BlogStack editor and a page in the customer’s site.</figcaption>
</figure>
<style>
  .publishing-flow { margin: 0; background: radial-gradient(ellipse at 68% 31%, #8c8f2520, transparent 58%); padding: 31px 26px 14px; }
  .flow-content { display: grid; grid-template-columns: minmax(0, 1fr) 43px minmax(0, 1.07fr); align-items: center; }
  .flow-editor, .flow-site { min-width: 0; border: 1px solid #3c3f30; border-radius: 10px; background: #191b16; overflow: hidden; }
  .flow-site { box-shadow: 0 15px 27px #091005a0; }
  .flow-top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 7px 12px; padding: 13px 15px; background: #21241c; color: #e9e7d9; font: 400 .67rem var(--mono); }
  .draft-indicator, .live-indicator { color: #c7d09b; }
  .draft-indicator::before, .live-indicator::before { content: ""; display: inline-block; width: 5px; height: 5px; margin-right: 6px; vertical-align: 2px; border-radius: 50%; background: #a9b276; }
  .live-indicator::before { background: var(--accent); }
  .flow-writing { padding: 18px 16px 16px; }
  .flow-title { font: 500 .97rem/1.4 var(--sans); letter-spacing: -.01em; }
  .flow-text { margin: 9px 0 18px; color: var(--text-muted); font-size: .81rem; line-height: 1.5; }
  .flow-seo { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 10px; border-top: 1px solid #3c3f30; padding: 11px 0 13px; color: #c3c5b4; font: .63rem var(--mono); }
  .flow-publish { font: 600 .68rem var(--sans); padding: 7px 10px; border-radius: 5px; color: #16190c; background: #dfea91; display: inline-block; }
  .flow-connector { position: relative; height: 1px; border-top: 1px dashed #b8c276; }
  .flow-connector span { position: absolute; right: 0; top: -5px; height: 8px; width: 8px; border-right: 1px solid #e7ef9e; border-top: 1px solid #e7ef9e; transform: rotate(45deg); }
  .flow-story { padding: 13px 15px 19px; }
  .story-title { font: 400 clamp(1.24rem, 2.3vw, 1.77rem)/1.04 var(--serif); margin-bottom: 7px; color: #f4f2e5; }
  .flow-story p:last-child { font: 400 .68rem var(--mono); color: #adb49e; }
  figcaption { margin: 15px 0 0; text-align: center; font-size: .72rem; color: var(--text-muted); }
  @media (max-width: 580px) {
    .publishing-flow { padding: 16px 12px 12px; }
    .flow-content { grid-template-columns: 1fr; }
    .flow-connector { justify-self: center; width: 1px; border-top: 0; border-left: 1px dashed #b8c276; height: 21px; }
    .flow-connector span { top: auto; bottom: 2px; right: -3px; transform: rotate(135deg); }
  }
</style>
