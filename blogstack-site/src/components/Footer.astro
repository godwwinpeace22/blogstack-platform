---
import { DEMO_URL, DOCS_URL, SOCIAL_LINKS, SUPPORT_EMAIL } from "../lib/site";
---
<footer class="footer"><div class="footer-inner"><div class="footer-brand"><a href="/" class="brand-link" aria-label="BlogStack home"><img src="/brand/blogstack-horizontal-on-dark.svg" alt="BlogStack" width="1000" height="256" /></a><p>Good ideas. Your own website.</p><div class="footer-socials">{SOCIAL_LINKS.map(link=><a href={link.href} rel="noopener noreferrer nofollow" target="_blank">{link.label}</a>)}</div></div><div class="footer-cols"><nav aria-label="Product"><p>Product</p><a href="/features">Features</a><a href="/pricing">Pricing</a><a href="/#self-hosting">Self-hosting</a><a href="/get-started">AI setup</a><a href={DEMO_URL}>Live blog</a></nav><nav aria-label="Resources"><p>Resources</p><a href={DOCS_URL}>Documentation</a><a href={DOCS_URL+"/docs/api-reference"}>API reference</a><a href="/support">Support</a><a href={"mailto:"+SUPPORT_EMAIL}>Contact</a></nav><nav aria-label="Legal"><p>Legal</p><a href="/privacy">Privacy policy</a><a href="/terms">Terms of service</a><a href="/cookies">Cookie policy</a><a href="/refunds">Refund requests</a><button type="button" data-cookie-settings>Cookie preferences</button></nav></div></div><div class="footer-bottom"><p>&copy; {new Date().getFullYear()} BlogStack</p><p>For the stories only you can tell.</p></div></footer>
<style>.footer{max-width:1240px;margin:40px auto 0;padding:65px 32px 26px;border-top:1px solid rgba(255,255,255,.08)}.footer-inner{display:flex;gap:70px;justify-content:space-between}.brand-link{display:inline-flex;max-width:100%;align-items:center}.brand-link img{display:block;width:180px;max-width:100%;height:auto}.footer-brand>p{color:var(--text-muted);font-size:.9rem;margin-top:12px}.footer-socials{display:flex;gap:22px;flex-wrap:wrap;font-size:.8rem;color:var(--text-muted);margin-top:26px}.footer-cols{display:grid;grid-template-columns:repeat(3,1fr);gap:50px}.footer-cols nav{display:flex;flex-direction:column;align-items:start;gap:12px}.footer-cols nav>p{font-size:.78rem;color:var(--text);font-weight:500;margin-bottom:5px}.footer-cols a,.footer-cols button{font:400 .85rem var(--sans);color:var(--text-muted);text-align:left;line-height:1.6}.footer-cols button{border:0;padding:0;background:none;cursor:pointer}.footer a:hover,.footer button:hover{color:var(--text)}.footer-bottom{display:flex;justify-content:space-between;gap:20px;font-size:.75rem;color:var(--text-muted);border-top:1px solid rgba(255,255,255,.05);padding-top:24px;margin-top:50px}@media(max-width:850px){.footer-inner{flex-direction:column;gap:42px}.footer-cols{gap:32px}.footer{margin-top:20px}}@media(max-width:480px){.footer{padding:44px 20px 25px}.footer-cols{grid-template-columns:1fr 1fr;gap:30px 24px}.footer-bottom{flex-direction:column;gap:8px}.footer-cols a,.footer-cols button{font-size:.82rem}}</style>
