---
const navLinks = [
  { href: "/pricing", label: "Pricing" },
  { href: "/blog", label: "Blog" },
  { href: "https://blogstack-docs.hidden-silence-2d18.workers.dev", label: "Docs" },
];
---

<header class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-brand" aria-label="BlogStack home">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
        <rect width="28" height="28" rx="6" fill="#7c6af7" />
        <rect x="7" y="8" width="14" height="2.5" rx="1.25" fill="white" />
        <rect x="7" y="12.75" width="10" height="2.5" rx="1.25" fill="white" />
        <rect x="7" y="17.5" width="7" height="2.5" rx="1.25" fill="white" />
      </svg>
      <span class="nav-brand-text">BlogStack</span>
    </a>

    <nav class="nav-links" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </nav>

    <div class="nav-actions">
      <a href="https://blogstack-app.hidden-silence-2d18.workers.dev/login" class="btn-ghost">Sign in</a>
      <a href="https://blogstack-app.hidden-silence-2d18.workers.dev/register" class="btn-primary">Start free trial</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(10, 10, 15, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .nav-inner {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-weight: 700;
    font-size: 1.125rem;
  }

  .nav-links {
    display: flex;
    gap: 0.125rem;
    flex: 1;
  }

  .nav-link {
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    font-size: 0.9375rem;
    color: var(--color-muted);
    transition: color 0.15s, background 0.15s;
  }

  .nav-link:hover {
    color: var(--color-text);
    background: var(--color-border);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }

  .btn-ghost {
    padding: 0.4375rem 1rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
    border-radius: 6px;
    transition: color 0.15s;
  }
  .btn-ghost:hover {
    color: var(--color-text);
  }

  .btn-primary {
    padding: 0.5rem 1.125rem;
    font-size: 0.9375rem;
    font-weight: 600;
    background: var(--color-accent);
    color: #fff;
    border-radius: 8px;
    transition: opacity 0.15s, transform 0.1s;
    white-space: nowrap;
  }
  .btn-primary:hover {
    opacity: 0.88;
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .nav-links {
      display: none;
    }
  }
</style>
