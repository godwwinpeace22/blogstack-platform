---
interface Props {
  kind: "routes" | "release" | "draft";
}
const { kind } = Astro.props;
---
<div class:list={["article-graphic", kind]} aria-hidden="true">
  {kind === "routes" && (
    <div class="route-lines">
      <span>/blog</span>
      <i></i>
      <span>/blog/[slug]</span>
    </div>
  )}
  {kind === "release" && (
    <div class="release-pages">
      <div class="back-page"></div>
      <div class="front-page">
        <span class="page-block"></span>
        <span class="page-lines"><i></i><i></i><i></i></span>
      </div>
    </div>
  )}
  {kind === "draft" && (
    <div class="draft-pages">
      <span><i></i><i></i><i></i></span>
      <span class="draft-next"><i></i><i></i><i></i></span>
    </div>
  )}
</div>
<style>
  .article-graphic {
    display: grid;
    place-items: center;
    min-height: 112px;
    aspect-ratio: 2.5;
    overflow: hidden;
    isolation: isolate;
    background-color: #1d2114;
    background-image: radial-gradient(ellipse at 64% 28%, #71803a52, transparent 65%), radial-gradient(#d9e9892d 1px, transparent 1px);
    background-size: auto, 12px 12px;
    color: #e9edc4;
    font: 400 .75rem var(--mono);
    border-bottom: 1px solid #e8ff4724;
  }
  .routes { background-color: #24251a; }
  .route-lines { display: flex; align-items: center; gap: 0; max-width: 90%; }
  .route-lines span { border: 1px solid #d1df755e; background: #323820; padding: .48rem .65rem; border-radius: 6px; white-space: nowrap; }
  .route-lines span:last-child { color: #e8fa9b; background: #424a27; }
  .route-lines i { width: clamp(10px, 4vw, 38px); flex: 0 1 auto; border-top: 1px dashed #c6de6e; }
  .release-pages { width: min(62%, 230px); height: 52%; position: relative; }
  .front-page, .back-page { position: absolute; inset: 0; border: 1px solid #e5f99769; border-radius: 8px; }
  .back-page { transform: translate(11%, -10%) rotate(4deg); background: #4f582f; opacity: .75; }
  .front-page { display: flex; align-items: center; gap: 12%; padding: 9%; background: #333b21; box-shadow: 0 18px 25px #12150865; }
  .page-block { width: 34%; align-self: stretch; border-radius: 3px; background: linear-gradient(143deg, #d7ea70, #85964a); }
  .page-lines { display: grid; min-width: 0; flex: 1; align-content: center; gap: 7px; }
  .page-lines i, .draft-pages i { height: 3px; border-radius: 9px; background: #a6b27086; }
  .page-lines i:first-child { width: 79%; background: #e4eea6; }
  .page-lines i:last-child { width: 56%; }
  .draft-pages { position: relative; width: min(47%, 174px); height: 53%; }
  .draft-pages span { position: absolute; inset: 0; display: grid; align-content: center; gap: 7px; padding: 13%; border: 1px solid #bfc8855e; border-radius: 6px; background-color: #434a2b; transform: translateX(-15%) rotate(-5deg); }
  .draft-pages .draft-next { background-color: #2e3821; transform: translateX(18%) rotate(7deg); border-style: dashed; }
  .draft-pages i:nth-child(2) { width: 84%; }
  .draft-pages i:last-child { width: 57%; }
</style>
