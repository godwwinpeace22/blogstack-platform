---

<section class="cta-section">
  <div class="cta-inner">
    <h2 class="cta-heading">Start publishing today.</h2>
    <p class="cta-sub">
      Free tier includes 3 projects, 100 posts, and 1 GB of media storage.
      No credit card required.
    </p>
    <div class="cta-actions">
      <a href="https://blogstack-app.hidden-silence-2d18.workers.dev/register" class="btn-primary">
        Create your free account
      </a>
      <a href="https://blogstack-docs.hidden-silence-2d18.workers.dev/docs/quickstart" class="btn-ghost">
        View quickstart guide
      </a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: 5rem 1.5rem;
  }

  .cta-inner {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    background: linear-gradient(135deg, rgba(124, 106, 247, 0.12), rgba(167, 139, 250, 0.06));
    border: 1px solid rgba(124, 106, 247, 0.25);
    border-radius: 20px;
    padding: 4rem 2.5rem;
  }

  .cta-heading {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .cta-sub {
    font-size: 1.0625rem;
    color: var(--color-muted);
    line-height: 1.7;
    margin-bottom: 2.25rem;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.75rem;
    background: var(--color-accent);
    color: #fff;
    font-weight: 600;
    font-size: 0.9375rem;
    border-radius: 8px;
    transition: opacity 0.15s, transform 0.15s;
  }
  .btn-primary:hover {
    opacity: 0.88;
    transform: translateY(-1px);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.75rem;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-weight: 500;
    font-size: 0.9375rem;
    border-radius: 8px;
    transition: border-color 0.15s, background 0.15s;
  }
  .btn-ghost:hover {
    border-color: var(--color-muted);
    background: rgba(255, 255, 255, 0.04);
  }
</style>
