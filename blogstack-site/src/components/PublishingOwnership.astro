---
import { DOCS_URL, SOURCE_URL } from "../lib/site";
---
<section class="m-section" id="ownership" aria-labelledby="ownership-title">
  <div class="m-split ownership-grid">
    <div>
      <div class="m-eyebrow">Content and source</div>
      <h2 class="m-title" id="ownership-title">Keep what<br/><em>you publish.</em></h2>
      <p class="m-copy">Export posts, drafts, and tags as JSON and download your original images. The blog pages are source files in your project, so your team can keep working on the design.</p>
      <div class="m-actions">
        <a class="m-link" href={DOCS_URL + "/docs/media"}>See how exports work</a>
        <a class="m-link" href={SOURCE_URL}>Browse the source</a>
      </div>
    </div>
    <figure class="m-shell ownership-graphic" aria-label="What you can take with you from BlogStack">
      <dl class="m-panel">
        <div data-format="JSON"><dt>Content export</dt><dd>Posts, drafts, and tags</dd></div>
        <div data-format="MEDIA"><dt>Image downloads</dt><dd>Original files</dd></div>
        <div data-format="MIT"><dt>Platform source</dt><dd>Dashboard, API, SDK, and UI</dd></div>
      </dl>
    </figure>
  </div>
</section>
<style>
  .ownership-graphic { margin: 0; }
  .ownership-graphic dl { margin: 0; padding: 6px 20px; background: linear-gradient(132deg, #22251a, #181914 68%); border-radius: 14px; }
  .ownership-graphic dl div { display: grid; grid-template-columns: 67px 1fr; column-gap: 15px; padding: 17px 2px; border-bottom: 1px solid #ddddb41e; }
  .ownership-graphic dl div:last-child { border-bottom: 0; }
  .ownership-graphic dl div::before { content: attr(data-format); grid-row: span 2; align-self: center; justify-self: start; padding: 6px 8px; border: 1px solid #e8ff4740; border-radius: 4px; font: .68rem var(--mono); color: #d9ec91; background: #d2ea6712; }
  .ownership-graphic dt { color: var(--text); font-weight: 500; }
  .ownership-graphic dd { grid-column: 2; margin: 4px 0 0; color: var(--text-muted); font-size: .85rem; }
</style>
